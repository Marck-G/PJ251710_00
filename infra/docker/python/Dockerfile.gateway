# infra/docker/python/Dockerfile.gateway
FROM python:3.12-slim

WORKDIR /app
COPY ../../python/gateway-api/pyproject.toml ./
RUN pip install poetry && poetry config virtualenvs.create false && poetry install --no-root

COPY ../../python/gateway-api /app
EXPOSE 8000
CMD ["poetry", "run", "uvicorn", "gateway_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
